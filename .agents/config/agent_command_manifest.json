{
  "schema_version": 1,
  "commands": {
    "automation_list_operations": {
      "command": ["python", "main.py", "--automation-list-operations"],
      "output": "json",
      "purpose": "List versioned ActiveGraph MCP/CLI operation contracts."
    },
    "automation_init_workspace": {
      "command": [
        "python",
        "main.py",
        "--automation-init-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Initialize an ActiveGraph automation workspace (EventStore + runtime pin)."
    },
    "automation_workspace_status": {
      "command": [
        "python",
        "main.py",
        "--automation-workspace-status",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Show pinned ActiveGraph workspace runtime status."
    },
    "automation_validate_proposal": {
      "command": [
        "python",
        "main.py",
        "--automation-validate-proposal",
        "<proposal.json>"
      ],
      "output": "json",
      "purpose": "Deterministically validate an Automation Proposal JSON file."
    },
    "automation_register_proposal": {
      "command": [
        "python",
        "main.py",
        "--automation-register-proposal",
        "<proposal.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Register a validated proposal as an immutable Definition Version."
    },
    "automation_grant_approval": {
      "command": [
        "python",
        "main.py",
        "--automation-grant-approval",
        "<grant.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Grant approval bound to a Definition Version for R3/R4 writes."
    },
    "automation_execute_read": {
      "command": [
        "python",
        "main.py",
        "--automation-execute-read",
        "<request.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Execute a read-only definition via a capability port."
    },
    "automation_execute_write": {
      "command": [
        "python",
        "main.py",
        "--automation-execute-write",
        "<request.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Execute an approval-gated write via a capability port."
    },
    "automation_inspect": {
      "command": [
        "python",
        "main.py",
        "--automation-inspect",
        "<run_id>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Project Run summary from the EventStore."
    },
    "automation_export_evidence": {
      "command": [
        "python",
        "main.py",
        "--automation-export-evidence",
        "<run_id>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Export evidence references for a run."
    },
    "automation_reconcile": {
      "command": [
        "python",
        "main.py",
        "--automation-reconcile",
        "<request.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Reconcile a needs_reconciliation run after an ambiguous write."
    },
    "automation_propose_repair": {
      "command": [
        "python",
        "main.py",
        "--automation-propose-repair",
        "<request.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Open a repair proposal from failure evidence."
    },
    "automation_trial_repair": {
      "command": [
        "python",
        "main.py",
        "--automation-trial-repair",
        "<request.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Trial a repair proposal in a fork (never patch the live parent)."
    },
    "automation_promote_repair": {
      "command": [
        "python",
        "main.py",
        "--automation-promote-repair",
        "<request.json>",
        "--automation-workspace",
        "<workspace_path>"
      ],
      "output": "json",
      "purpose": "Promote a successful repair trial to a new Definition Version."
    }
  }
}
